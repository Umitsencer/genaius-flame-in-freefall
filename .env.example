# Local OpenRouter configuration template (optional — server runs deterministically without a key).
# Copy this file to `.env` locally (never commit `.env`) and fill your own key if testing live `:free` synthesis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_TOKENS=1200
OPENROUTER_VERIFY_FREE_CATALOG=true
OPENROUTER_USE_JSON_SCHEMA=true
GENAIUS_LLM_ENABLED=true
